TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# LLMTR (https://llmtr.com): with an LLMTR key, change the values above to TEXT_MODEL_BASE_URL=https://llmtr.com/v1
# and TEXT_MODEL=agnes/agnes-3.0-flash (free, with a daily request quota). LLMTR reads reasoning from the model id.
