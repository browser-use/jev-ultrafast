TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Or route through Vercel AI Gateway with one gateway key for both models:
# TYPESAFE_BASE_URL=https://ai-gateway.vercel.sh
# TYPESAFE_MODEL=typesafe-ai/jev
# TEXT_MODEL_BASE_URL=https://ai-gateway.vercel.sh/v1
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
