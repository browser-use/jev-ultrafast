TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
# TEXT_MODEL and TEXT_MODEL_BASE_URL travel together: point the endpoint at whoever issued the
# key. Set only one and the helper refuses rather than sending the key to the DeepSeek default —
# except for a first-party deepseek-* model, where the paired defaults are the point.
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
# none = disable reasoning in the endpoint's own dialect: OpenRouter speaks
#        {"reasoning": {"enabled": false}}, DeepSeek and Fireworks speak
#        {"thinking": {"type": "disabled"}}. Sending the wrong spelling is itself an unknown key.
# omit = send no reasoning field at all, for endpoints that reject the unknown key
#        (Fireworks "Extra inputs are not permitted", Groq "property 'reasoning' is unsupported",
#        Gemini 'Unknown name "reasoning"'). Any other value is rejected.
# Unset = the endpoint's default payload; an unrecognised endpoint gets no reasoning field rather
#         than a key it may refuse.
TEXT_MODEL_REASONING=none
