TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Optional Chrome connection overrides (empty = unset). Otherwise Jev finds DevToolsActivePort.
# BU_CDP_WS=ws://127.0.0.1:9222/devtools/browser/<id>
# BU_CDP_URL=http://127.0.0.1:9222
# Optional inspector port for `deno task demo` (default 8766).
# TYPESAFE_DEMO_PORT=8766
