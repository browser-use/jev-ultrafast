TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Optional: serve the same System One protocol from a different host. Left unset, the client
# posts to TypeSafe's own https://api.typesafe.ai/v1/systemone.
# OpenRouter serves Jev as a decisions model (not chat/completions), for example:
# TYPESAFE_ENDPOINT=https://openrouter.ai/api/alpha/decisions
# TYPESAFE_MODEL=~typesafe/jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
