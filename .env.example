TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Optional. JSON {"field label": value} for password fields; typed locally, never sent to a model. Keep the
# single quotes, so a # or a space inside the secret survives: JEV_SECRETS='{"Password": "..."}'
JEV_SECRETS=
