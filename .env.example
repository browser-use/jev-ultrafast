# ─────────────────────────────────────────────────────────────────────────────
# Three independent model roles — mix providers freely (e.g. Groq + NVIDIA NIM
# at the same time). Each role resolves its own provider, key, and model.
#
#   PLANNER  – decomposes the mission into a step checklist (optional; without
#              it the agent keeps the original single-goal loop).
#   POLICY   – the fast executor: picks operation + element on every step.
#   TEXT     – writes TYPE_TEXT field values.
#
# If TYPESAFE_API_KEY is set, it wins for the policy role (planner still applies).
# ─────────────────────────────────────────────────────────────────────────────

# ── Fast executor (policy) · GPT-OSS-20B on Groq ────────────────────────────
POLICY_PROVIDER=groq
GROQ_API_KEY=
POLICY_MODEL=openai/gpt-oss-20b
POLICY_REASONING=low
# Groq maps none→low and low/medium/high→reasoning_effort for gpt-oss models.

# ── Planner · GLM-5.3 on NVIDIA NIM ─────────────────────────────────────────
# Check the exact model id at https://build.nvidia.com/models
PLANNER_PROVIDER=nvidia
NVIDIA_API_KEY=
PLANNER_MODEL=z-ai/glm-5.3
# PLANNER_REASONING=none

# ── Text helper · GPT-OSS-20B on Groq (fast field values) ──────────────────
# Measured ~300 ms per field vs ~22 s with z-ai/glm-5.3-flash on NVIDIA.
TEXT_MODEL_PROVIDER=groq
# Reuses GROQ_API_KEY above; or set TEXT_MODEL_API_KEY explicitly.
TEXT_MODEL=openai/gpt-oss-20b
TEXT_MODEL_REASONING=low

# ── Original fast path (optional) ───────────────────────────────────────────
# TypeSafe Jev executes the steps instead of the policy provider above.
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# ── Any other combination works the same way ────────────────────────────────
# POLICY_/PLANNER_/TEXT_MODEL_ accept the same presets: openai, anthropic,
# openrouter, nvidia, omniroute, deepseek, groq, together, mistral, xai, gemini,
# custom, or a full https:// base URL. Key fallbacks per provider (OPENAI_API_KEY,
# ANTHROPIC_API_KEY, ...) apply to every role. See docs/providers.md.

# ── Firefox extension bridge (optional) ─────────────────────────────────────
# FIREFOX_BRIDGE_PORT=8767
# FIREFOX_BRIDGE_TOKEN=          # optional shared secret; the extension sends it on hello

# ── Sidebar model panel (optional; see docs/providers.md) ───────────────────
# Choices made in the sidebar persist to artifacts/model-config.json and
# override these .env defaults on the next start.
# JEV_MODEL_CONFIG=artifacts/model-config.json
# JEV_MODEL_REGISTRY=artifacts/model-registry.json
# PLANNER_TEMPERATURE=0.5     # per-role creativity, 0–2 (also POLICY_/TEXT_MODEL_)

# ---- 100% free / offline option (no API key) ----
# Any local OpenAI-compatible runtime: ollama, lmstudio, llamacpp, jan.
# Example with Ollama (https://ollama.com):  ollama pull qwen3.5:4b
# POLICY_PROVIDER=ollama
# POLICY_MODEL=qwen3.5:4b
# TEXT_MODEL_PROVIDER=ollama
# TEXT_MODEL=qwen3.5:4b
# Hardware guide (Spanish): docs/modelos-locales.md
